# Sao chép file này thành .env (local) hoặc khai báo trong Vercel > Settings > Environment Variables

# Email Gmail dùng để GỬI thông báo (không phải email nhận)
EMAIL_USER=your-gmail-address@gmail.com

# App Password 16 ký tự của Gmail — KHÔNG dùng mật khẩu đăng nhập Gmail thường
# Tạo tại: https://myaccount.google.com/apppasswords (yêu cầu bật xác minh 2 bước)
EMAIL_PASS=xxxxxxxxxxxxxxxx

# Email NHẬN thông báo khi có khách đăng ký (mặc định: hoanglam1209@gmail.com)
EMAIL_TO=hoanglam1209@gmail.com
